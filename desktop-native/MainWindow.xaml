<Window x:Class="MiniChat.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MiniChat Native · Preview" Width="1120" Height="780" MinWidth="760" MinHeight="540" Background="#151617" Foreground="#EEEEEE">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="MiniChat Native" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="Native Windows preview · Text channels only. Voice, video, DMs and admin tools are still being migrated." TextWrapping="Wrap" Foreground="#ABB2C0" Margin="4,0,4,16"/>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="4,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" MaxWidth="440">
      <TextBlock Text="Instance address"/><TextBox x:Name="Instance" Text="https://" AutomationProperties.Name="Instance address"/>
      <TextBlock Text="Username"/><TextBox x:Name="Username" AutomationProperties.Name="Username"/>
      <TextBlock Text="Password"/><PasswordBox x:Name="Password" Padding="8" Margin="4" AutomationProperties.Name="Password"/>
      <Button x:Name="LoginButton" Content="Sign in" Click="Login" IsDefault="True"/>
    </StackPanel>
    <Grid x:Name="ChatPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,16,0">
        <Button DockPanel.Dock="Bottom" Content="Sign out" Click="Logout"/>
        <TextBlock DockPanel.Dock="Top" Text="CHANNELS" FontWeight="Bold" Margin="4,12"/>
        <ListBox x:Name="Channels" DisplayMemberPath="name" SelectionChanged="SelectChannel" AutomationProperties.Name="Channels"/>
      </DockPanel>
      <DockPanel Grid.Column="1">
        <TextBlock x:Name="ChannelTitle" DockPanel.Dock="Top" FontSize="20" Margin="4,8"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Click="Send" IsEnabled="False"/>
          <TextBox x:Name="Draft" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" MinHeight="64" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Message"/>
        </DockPanel>
        <ListBox x:Name="Messages" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Messages">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8">
            <TextBlock Text="{Binding AuthorName}" FontWeight="Bold"/>
            <TextBlock Text="{Binding content}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding AttachmentNames}" TextWrapping="Wrap" Foreground="#555555"/>
          </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

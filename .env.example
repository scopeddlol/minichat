# ============================================================================
#  MiniChat configuration
#  Copy this file to .env and fill it in:  cp .env.example .env
# ============================================================================

# ---- Domains ---------------------------------------------------------------
# Both must already point at this server's public IP (an A/AAAA record each)
# before you start the stack — Caddy verifies them when it requests
# certificates.
DOMAIN=chat.example.com
LIVEKIT_DOMAIN=livekit.chat.example.com

# Where Let's Encrypt sends expiry warnings. Optional but recommended.
ACME_EMAIL=you@example.com

# ---- Secrets ---------------------------------------------------------------
# Generate each of these once and keep them out of version control.
#
#   JWT_SECRET:         openssl rand -hex 32
#   LIVEKIT_API_SECRET: openssl rand -hex 32
#   SETUP_TOKEN:        openssl rand -hex 16
#
# Changing JWT_SECRET signs every member out.
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# LiveKit credentials. The key is a public identifier; the secret is not.
LIVEKIT_API_KEY=minichat
LIVEKIT_API_SECRET=replace-me-with-openssl-rand-hex-32

# Optional. When set, the first-run setup wizard demands this token before it
# will create the operator account. Worth setting if your instance is reachable
# from the internet before you get a chance to run the wizard yourself.
SETUP_TOKEN=

# ---- Logging ---------------------------------------------------------------
# Use minichat_server=debug when you need to see individual requests.
RUST_LOG=minichat_server=info,tower_http=warn

// A stroked icon.
//
// `size` is the box the glyph occupies; the 24-unit viewbox scales into it,
// so the stroke stays visually 2px at any size rather than thinning out.
export component Icon inherits Rectangle {
    in property <string> data;
    in property <brush> colour;
    in property <length> size: 18px;
    // Filled icons (the presence dot, the maximise square) set this.
    in property <bool> filled: false;

    width: root.size;
    height: root.size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.data;
        stroke: root.filled ? transparent : root.colour;
        fill: root.filled ? root.colour : transparent;
        // Lucide draws at 2 units of a 24-unit viewbox. Slint applies
        // stroke-width in the element's own coordinates, so the 2 units are
        // converted rather than used directly — the other way round makes
        // every icon heavier the smaller it gets, which at 12px is a blob.
        stroke-width: 2px * root.size / 24px;
        stroke-line-cap: round;
    }
}

// The chat pane: channel header, message list, composer.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, Divider, Avatar } from "controls.slint";
import { MessageItem, Metrics } from "messages.slint";
import { Composer } from "composer.slint";
import { MessageRow, PendingAttachment } from "models.slint";

export component ChatPane {
    in property <string> channel-name;
    in property <string> channel-topic;
    in property <string> channel-kind: "text";
    in property <bool> channel-private;
    in property <[MessageRow]> messages;
    in property <bool> loading;
    in property <bool> members-open: true;
    in property <bool> can-send: true;
    in property <string> compose-notice;
    in property <[PendingAttachment]> pending-attachments;
    in property <string> replying-to;
    in property <string> typing-line;
    in-out property <string> draft;
    in property <string> editing-id;
    in-out property <string> edit-draft;
    /// Bumped by the Rust side to ask for a jump to the newest message.
    /// A property rather than a called function because the pane lives
    /// inside an `if`, and an element in a conditional has no id the
    /// surrounding scope can reach.
    in property <int> scroll-to-newest;
    in property <int> focus-composer;
    /// How far the newest message is below the fold, from the last scroll.
    in property <length> scroll-distance;

    callback send(string);
    callback cancel-reply();
    callback remove-attachment(string);
    callback attach();
    callback emoji();
    callback typing();
    callback toggle-members();
    callback open-search();
    callback open-pins();
    callback react(string, string);
    callback reply-to(string);
    callback forward-message(string);
    callback edit-message(string);
    callback delete-message(string);
    callback pin-message(string);
    callback open-author(string);
    callback run-activated(string, int);
    callback open-attachment(string);
    callback scrolled(length, length, length);

    changed scroll-to-newest => {
        self.scroll-to-bottom();
    }
    callback body-width-changed(length);
    callback message-menu(string);
    callback save-edit(string);
    callback cancel-edit();

    VerticalLayout {
        // --- header ------------------------------------------------------
        Rectangle {
            height: 56px;
            background: Theme.surface-1;

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 12px;
                spacing: 10px;

                Icon {
                    data: root.channel-kind == "voice" ? Icons.volume
                        : root.channel-kind == "announcement" ? Icons.megaphone
                        : root.channel-private ? Icons.shield
                        : Icons.hash;
                    size: 19px;
                    colour: Theme.text-faint;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.channel-name;
                    color: Theme.text;
                    font-size: 15.5px;
                    font-weight: 650;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.channel-topic != "": Rectangle {
                    width: 1px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border;
                }
                if root.channel-topic != "": Text {
                    text: root.channel-topic;
                    color: Theme.text-faint;
                    font-size: 12.8px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.channel-topic == "": Rectangle { horizontal-stretch: 1; }

                IconButton {
                    icon: Icons.pin;
                    tooltip: "Pinned messages";
                    y: (parent.height - self.height) / 2;
                    clicked => { root.open-pins(); }
                }
                IconButton {
                    icon: Icons.search;
                    tooltip: "Search";
                    y: (parent.height - self.height) / 2;
                    clicked => { root.open-search(); }
                }
                IconButton {
                    icon: Icons.users;
                    tooltip: root.members-open ? "Hide members" : "Show members";
                    active: root.members-open;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-members(); }
                }
            }
        }
        Divider {}

        // --- messages ----------------------------------------------------
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            // The column a message body wraps into: the pane, less the side
            // padding and the avatar gutter. Reported to Rust because the
            // flow layout runs there, and it has to be redone on a resize.
            changed width => {
                root.body-width-changed(self.width - Metrics.side-padding * 2 - Metrics.body-x);
            }

            if root.loading && root.messages.length == 0: VerticalLayout {
                alignment: center;
                Text {
                    text: "Loading messages\u{2026}";
                    color: Theme.text-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            // The empty state doubles as the channel's introduction, the way
            // the web client opens a channel you have never posted in.
            if !root.loading && root.messages.length == 0: VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding-left: 40px;
                padding-right: 40px;

                Rectangle {
                    height: 56px;
                    width: 56px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 28px;
                    background: Theme.surface-2;
                    Icon {
                        data: root.channel-kind == "voice" ? Icons.volume : Icons.hash;
                        size: 26px;
                        colour: Theme.text-faint;
                    }
                }
                Text {
                    text: "Welcome to #" + root.channel-name;
                    color: Theme.text;
                    font-size: 19px;
                    font-weight: 650;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.channel-topic != "" ? root.channel-topic
                        : "This is the beginning of the channel.";
                    color: Theme.text-faint;
                    font-size: 13.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // "Jump to present", shown once the newest message is off
            // screen. Without it a reader who has scrolled back has to drag
            // all the way down again.
            //
            // A fixed width rather than one derived from the label: deriving
            // it would make the button's width depend on a layout inside the
            // button, which depends on the button's width.
            if root.scroll-distance > 200px: Rectangle {
                x: parent.width - self.width - 24px;
                y: parent.height - self.height - 14px;
                width: 168px;
                height: 34px;
                border-radius: 17px;
                background: pounce.has-hover ? Theme.surface-3 : Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border;
                animate background { duration: Theme.normal; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    padding-left: 14px;
                    padding-right: 14px;

                    Icon {
                        data: Icons.arrow-down;
                        size: 15px;
                        colour: Theme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Jump to present";
                        color: Theme.text;
                        font-size: 12.3px;
                        font-weight: 560;
                        vertical-alignment: center;
                    }
                }

                pounce := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.scroll-to-bottom(); }
                }
            }

            scroll := Flickable {
                content-height: stack.preferred-height;

                // How far the newest message is below the fold. Reported so
                // the Rust side can decide whether an arriving message
                // should scroll the view: it should when you are reading the
                // bottom of the channel, and must not when you have
                // deliberately scrolled up.
                changed content-y => {
                    root.scrolled(
                        -self.content-y - (self.content-height - self.height),
                        self.content-height,
                        self.height,
                    );
                }

                stack := VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 12px;
                    spacing: 0px;

                    for message in root.messages: MessageItem {
                        message: message;
                        editing-id: root.editing-id;
                        edit-draft <=> root.edit-draft;
                        save-edit(text) => { root.save-edit(text); }
                        cancel-edit => { root.cancel-edit(); }
                        react(id, emoji) => { root.react(id, emoji); }
                        reply => { root.reply-to(message.id); }
                        forward => { root.forward-message(message.id); }
                        edit => { root.edit-message(message.id); }
                        remove => { root.delete-message(message.id); }
                        pin => { root.pin-message(message.id); }
                        open-author(id) => { root.open-author(id); }
                        run-activated(target, kind) => { root.run-activated(target, kind); }
                        open-attachment(id) => { root.open-attachment(id); }
                        context-menu => { root.message-menu(message.id); }
                    }
                }
            }
        }

        // --- who is typing -------------------------------------------------
        if root.typing-line != "": Rectangle {
            height: 20px;
            background: Theme.bg;
            Text {
                x: Metrics.side-padding;
                text: root.typing-line;
                color: Theme.text-faint;
                font-size: 11.5px;
                vertical-alignment: center;
            }
        }

        // --- composer ------------------------------------------------------
        if root.can-send: composer := Composer {
                placeholder: "Message #" + root.channel-name;
                draft <=> root.draft;
                enabled: root.can-send;
                notice: root.compose-notice;
                attachments: root.pending-attachments;
                focus-token: root.focus-composer;
                remove-attachment(id) => { root.remove-attachment(id); }
                replying-to: root.replying-to;
                send(text) => { root.send(text); }
                cancel-reply => { root.cancel-reply(); }
                attach => { root.attach(); }
                emoji => { root.emoji(); }
                typing => { root.typing(); }
        }

        // The read-only notice an announcement channel shows in place of the
        // composer when the member may not post.
        if !root.can-send: Rectangle {
            height: 56px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: Metrics.side-padding;
                padding-right: Metrics.side-padding;
                spacing: 9px;
                alignment: start;
                Icon {
                    data: Icons.lock;
                    size: 15px;
                    colour: Theme.text-faint;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "You do not have permission to post in this channel.";
                    color: Theme.text-faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }

    /// Jump to the newest message.
    public function scroll-to-bottom() {
        scroll.content-y = min(0px, scroll.height - scroll.content-height);
    }
}

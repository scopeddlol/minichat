// Direct calls.
//
// `.call-panel` in the web client: a floating card in the bottom-right, over
// whatever else is open. It is the same card whether the call is ringing,
// being placed, or connected — only the controls change, so answering one
// does not make the window jump.

import { Theme, Elevation } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Avatar, Button, ButtonKind, Divider, IconButton } from "controls.slint";
import { MemberRow } from "models.slint";

component CallControl {
    in property <string> icon;
    in property <bool> danger: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked();

    width: 44px;
    height: 44px;

    Rectangle {
        border-radius: 22px;
        background: root.danger ? Theme.danger
            : root.active ? Theme.accent
            : touch.has-hover && root.enabled ? Theme.surface-3 : Theme.surface-2;
        opacity: root.enabled ? 1.0 : 0.4;
        animate background { duration: Theme.normal; }

        Icon {
            data: root.icon;
            size: 19px;
            colour: root.danger ? white
                : root.active ? Theme.accent-ink : Theme.text;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

export component CallPanel {
    in property <MemberRow> peer;
    /// "ringing" when they are calling me, "calling" when I am calling them,
    /// "connected" once answered.
    in property <string> phase;
    in property <string> duration;
    in property <bool> muted;
    in property <bool> deafened;
    in property <bool> can-speak;
    in property <string> notice;

    callback accept();
    callback decline();
    callback hang-up();
    callback toggle-mute();
    callback toggle-deafen();

    property <bool> incoming: root.phase == "ringing";
    property <bool> connected: root.phase == "connected";

    // `.call-panel { bottom: 24px; right: 24px; width: min(420px, …) }`
    width: 340px;
    height: (root.notice == "" ? 168px : 194px);

    Rectangle {
        background: Theme.surface-1;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;

        // Swallows clicks so they do not reach whatever is behind the card.
        TouchArea {}

        VerticalLayout {
            padding: 18px;
            spacing: 0px;

            HorizontalLayout {
                height: 56px;
                spacing: 14px;

                Avatar {
                    size: 48px;
                    picture: root.peer.avatar;
                    fallback: root.peer.avatar-fallback;
                    initials: root.peer.initials;
                    name: root.peer.name;
                    // A ring while it is ringing, which is the one moment
                    // the card has to catch someone's eye.
                    speaking: root.incoming;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: root.peer.name;
                        color: Theme.text;
                        font-size: 15.5px;
                        font-weight: 650;
                        overflow: elide;
                    }
                    Text {
                        text: root.connected ? root.duration
                            : root.incoming ? "Incoming call"
                            : "Calling\u{2026}";
                        color: root.connected ? Theme.success : Theme.text-muted;
                        font-size: 12.5px;
                    }
                }
            }

            Rectangle { height: 16px; }

            // Ringing gets accept and decline; anything else gets the call
            // controls. Same card, so answering does not move things.
            if root.incoming: HorizontalLayout {
                height: 40px;
                spacing: 10px;
                Button {
                    label: "Decline";
                    kind: ButtonKind.danger;
                    wide: true;
                    height: 40px;
                    clicked => { root.decline(); }
                }
                Button {
                    label: "Accept";
                    kind: ButtonKind.primary;
                    icon: Icons.volume;
                    wide: true;
                    height: 40px;
                    clicked => { root.accept(); }
                }
            }

            if !root.incoming: HorizontalLayout {
                height: 44px;
                spacing: 12px;
                alignment: center;

                CallControl {
                    icon: root.muted ? Icons.mic-off : Icons.mic;
                    danger: root.muted;
                    enabled: root.can-speak;
                    tooltip: root.muted ? "Unmute" : "Mute";
                    clicked => { root.toggle-mute(); }
                }
                CallControl {
                    icon: root.deafened ? Icons.headphones-off : Icons.headphones;
                    danger: root.deafened;
                    tooltip: root.deafened ? "Undeafen" : "Deafen";
                    clicked => { root.toggle-deafen(); }
                }
                CallControl {
                    icon: Icons.log-out;
                    danger: true;
                    tooltip: "Hang up";
                    clicked => { root.hang-up(); }
                }
            }

            // Keeps the content at the top of the card rather than letting
            // the layout spread it over the height.
            Rectangle { vertical-stretch: 1; }

            if root.notice != "": Rectangle { height: 8px; }
            if root.notice != "": Text {
                text: root.notice;
                color: Theme.text-faint;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}

// Direct messages.
//
// `.inbox`, `.inbox-list` and `.inbox-thread` in the web client: a list of
// conversations beside the open one. The thread reuses the channel message
// list, because a direct message is an ordinary message with a conversation
// in place of a channel.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Avatar, Button, ButtonKind, CountPill, Divider, IconButton, NavLabel, TextField } from "controls.slint";
import { MessageItem, Metrics } from "messages.slint";
import { Composer } from "composer.slint";
import { MessageRow, ConversationRow, MemberRow } from "models.slint";

// A person in the friends tab, with up to two actions.
component PersonRow {
    in property <MemberRow> member;
    in property <string> primary-label;
    in property <string> secondary-label;
    /// Blocked members are dimmed: they are listed to be undone, not read.
    in property <bool> muted: false;
    callback activated();
    callback primary();
    callback secondary();

    height: 46px;

    Rectangle {
        background: touch.has-hover ? Theme.surface-2 : transparent;
        border-radius: Theme.radius-control;
        animate background { duration: Theme.normal; }
        opacity: root.muted ? 0.65 : 1.0;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 10px;

            Avatar {
                size: 28px;
                picture: root.member.avatar;
                fallback: root.member.avatar-fallback;
                initials: root.member.initials;
                presence: root.muted ? "" : root.member.presence;
                name: root.member.name;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.member.name;
                color: Theme.text;
                font-size: 13.2px;
                font-weight: 550;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.secondary-label != "": Button {
                label: root.secondary-label;
                kind: ButtonKind.ghost;
                y: (parent.height - self.height) / 2;
                clicked => { root.secondary(); }
            }
            if root.primary-label != "": Button {
                label: root.primary-label;
                kind: root.secondary-label != "" ? ButtonKind.primary : ButtonKind.subtle;
                y: (parent.height - self.height) / 2;
                clicked => { root.primary(); }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

component ConversationButton {
    in property <ConversationRow> conversation;
    in property <bool> selected;
    callback activated();

    // `.conversation-row { padding: 14px 10px; border-radius: 7px }`
    height: 62px;

    Rectangle {
        background: root.selected ? Theme.surface-2
            : touch.has-hover ? Theme.surface-1 : transparent;
        border-radius: Theme.radius-control;
        animate background { duration: Theme.normal; easing: ease-out; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;

            Avatar {
                size: 36px;
                picture: root.conversation.avatar;
                fallback: root.conversation.avatar-fallback;
                initials: root.conversation.initials;
                presence: root.conversation.presence;
                name: root.conversation.name;
                y: (parent.height - self.height) / 2;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.conversation.name;
                        color: Theme.text;
                        font-size: 13.6px;
                        // `.conversation-row strong { font-weight: 550 }`,
                        // heavier while unread.
                        font-weight: root.conversation.unread > 0 ? 700 : 550;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.conversation.timestamp;
                        color: Theme.text-faint;
                        font-size: 10.8px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.conversation.excerpt;
                        color: root.conversation.unread > 0 ? Theme.text-muted : Theme.text-faint;
                        font-size: 12.2px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.conversation.unread > 0: CountPill {
                        count: root.conversation.unread;
                        mention: true;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

export component Inbox {
    in property <[ConversationRow]> conversations;
    /// Friend requests waiting on an answer, plus friends and blocked
    /// members — all `MemberRow`, distinguished by which list they are in.
    in property <[MemberRow]> requests;
    in property <[MemberRow]> friends;
    in property <[MemberRow]> blocked;
    /// 0 conversations, 1 friends.
    in property <int> tab;
    in property <string> selected;
    in property <[MessageRow]> messages;
    in property <string> peer-name;
    in property <string> peer-presence;
    in property <image> peer-avatar;
    in property <color> peer-avatar-fallback;
    in property <string> peer-initials;
    in property <bool> loading;
    in-out property <string> draft;
    in property <bool> voice-enabled;
    /// Bumped by Rust to jump to the newest message.
    in property <int> scroll-to-newest;

    callback open-conversation(string);
    callback choose-tab(int);
    callback accept-request(string);
    callback decline-request(string);
    callback unblock(string);
    callback message-friend(string);
    callback send(string);
    callback open-peer(string);
    callback call();
    callback back();
    callback body-width-changed(length);

    HorizontalLayout {
        spacing: 0px;

        // --- the conversation list -------------------------------------
        Rectangle {
            // `.inbox-list { width: clamp(220px, 24vw, 310px) }`
            width: 268px;
            // Without this the inbox reports the preferred height of its
            // contents, and the row it sits in — sidebar included — shrinks
            // to that instead of filling the window.
            vertical-stretch: 1;
            background: Theme.surface-0;

            VerticalLayout {
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 9px;
                        Icon {
                            data: Icons.message-square;
                            size: 16px;
                            colour: Theme.text-faint;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "Direct messages";
                            color: Theme.text;
                            font-size: 13.5px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.arrow-left;
                            tooltip: "Back to channels";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.back(); }
                        }
                    }
                }
                Divider {}

                // Two tabs: the conversations, and the people.
                Rectangle {
                    height: 42px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 4px;
                        for label[index] in ["Messages", "Friends"]: Rectangle {
                            background: index == root.tab ? Theme.surface-2
                                : tab-touch.has-hover ? Theme.surface-1 : transparent;
                            border-radius: Theme.radius-control;
                            animate background { duration: Theme.normal; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: label;
                                    color: index == root.tab ? Theme.text : Theme.text-muted;
                                    font-size: 12.8px;
                                    font-weight: index == root.tab ? 650 : 500;
                                    vertical-alignment: center;
                                }
                                // A request waiting on an answer is the one
                                // thing in here that is time-sensitive.
                                if index == 1 && root.requests.length > 0: CountPill {
                                    count: root.requests.length;
                                    mention: true;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            tab-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.choose-tab(index); }
                            }
                        }
                    }
                }

                if root.tab == 0 && root.conversations.length == 0: Text {
                    text: "No conversations yet.\n\nOpen someone's profile and send them a message.";
                    color: Theme.text-faint;
                    font-size: 12.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    height: 100px;
                    vertical-alignment: center;
                }

                if root.tab == 0: Flickable {
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        alignment: start;
                        padding: 8px;
                        spacing: 2px;
                        for conversation in root.conversations: ConversationButton {
                            conversation: conversation;
                            selected: conversation.id == root.selected;
                            activated => { root.open-conversation(conversation.id); }
                        }
                    }
                }

            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border-soft;
            }
        }

        // --- the open conversation ---------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Theme.bg;

            // The friends list takes the main pane rather than the narrow
            // column: two actions and a name do not fit in 268px.
            if root.tab == 1: Rectangle {
                VerticalLayout {
                    Rectangle {
                        height: 56px;
                        background: Theme.surface-1;
                        HorizontalLayout {
                            padding-left: 20px;
                            spacing: 9px;
                            Icon {
                                data: Icons.users;
                                size: 16px;
                                colour: Theme.text-faint;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "Friends";
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 650;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Divider {}

                    Flickable {
                        content-height: people.preferred-height;
                        people := VerticalLayout {
                            alignment: start;
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 12px;
                            padding-bottom: 20px;
                            spacing: 2px;

                            if root.requests.length > 0: NavLabel {
                                text: "REQUESTS \u{2014} " + root.requests.length;
                                x: 8px;
                            }
                            for member in root.requests: PersonRow {
                                member: member;
                                primary-label: "Accept";
                                secondary-label: "Decline";
                                activated => { root.open-peer(member.id); }
                                primary => { root.accept-request(member.id); }
                                secondary => { root.decline-request(member.id); }
                            }

                            if root.requests.length > 0: Rectangle { height: 14px; }

                            NavLabel {
                                text: "FRIENDS \u{2014} " + root.friends.length;
                                x: 8px;
                            }
                            for member in root.friends: PersonRow {
                                member: member;
                                primary-label: "Message";
                                activated => { root.open-peer(member.id); }
                                primary => { root.message-friend(member.id); }
                            }
                            if root.friends.length == 0: Text {
                                text: "Nobody yet. Open someone's profile to add them as a friend.";
                                color: Theme.text-faint;
                                font-size: 12.5px;
                                wrap: word-wrap;
                                height: 44px;
                                x: 10px;
                                vertical-alignment: center;
                            }

                            if root.blocked.length > 0: Rectangle { height: 14px; }
                            if root.blocked.length > 0: NavLabel {
                                text: "BLOCKED \u{2014} " + root.blocked.length;
                                x: 8px;
                            }
                            for member in root.blocked: PersonRow {
                                member: member;
                                primary-label: "Unblock";
                                muted: true;
                                activated => { root.open-peer(member.id); }
                                primary => { root.unblock(member.id); }
                            }
                        }
                    }
                }
            }

            if root.tab == 0 && root.selected == "": VerticalLayout {
                alignment: center;
                spacing: 10px;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 28px;
                    background: Theme.surface-2;
                    Icon {
                        data: Icons.message-square;
                        size: 26px;
                        colour: Theme.text-faint;
                    }
                }
                Text {
                    text: "Pick a conversation";
                    color: Theme.text-muted;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }

            if root.tab == 0 && root.selected != "": VerticalLayout {
                // --- header -----------------------------------------------
                Rectangle {
                    height: 56px;
                    background: Theme.surface-1;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 12px;
                        spacing: 12px;

                        Avatar {
                            size: 32px;
                            picture: root.peer-avatar;
                            fallback: root.peer-avatar-fallback;
                            initials: root.peer-initials;
                            presence: root.peer-presence;
                            name: root.peer-name;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.peer-name;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.voice-enabled: IconButton {
                            icon: Icons.volume;
                            tooltip: "Start a call";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.call(); }
                        }
                        IconButton {
                            icon: Icons.user;
                            tooltip: "View profile";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.open-peer(root.selected); }
                        }
                    }
                }
                Divider {}

                // --- history ------------------------------------------------
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    // Mirrored so the handler sits in the same scope as the
                    // Flickable: an element inside an `if` has no id the
                    // surrounding scope can reach.
                    property <int> scroll-token: root.scroll-to-newest;
                    changed scroll-token => {
                        thread.content-y = min(0px, thread.height - thread.content-height);
                    }

                    changed width => {
                        root.body-width-changed(
                            self.width - Metrics.side-padding * 2 - Metrics.body-x);
                    }

                    if root.loading && root.messages.length == 0: Text {
                        text: "Loading\u{2026}";
                        color: Theme.text-faint;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if !root.loading && root.messages.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "This is the start of your conversation with "
                                + root.peer-name + ".";
                            color: Theme.text-faint;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    thread := Flickable {
                        content-height: stack.preferred-height;
                        stack := VerticalLayout {
                            padding-top: 20px;
                            padding-bottom: 12px;
                            spacing: 0px;
                            for message in root.messages: MessageItem {
                                message: message;
                                open-author(id) => { root.open-peer(id); }
                            }
                        }
                    }
                }

                // --- composer -------------------------------------------------
                Composer {
                    placeholder: "Message " + root.peer-name;
                    draft <=> root.draft;
                    can-attach: false;
                    send(text) => { root.send(text); }
                }
            }
        }
    }
}

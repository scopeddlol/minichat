// The member panel, grouped by hoisted role then by presence.
// `.member-panel` in the web client.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Avatar, NavLabel, Divider } from "controls.slint";
import { MemberRow, MemberGroup } from "models.slint";

component MemberButton {
    in property <MemberRow> member;
    callback activated();
    callback context-menu();

    // `.member-panel [data-user-id] { padding: 10px 8px }`
    height: 44px;

    Rectangle {
        background: touch.has-hover ? Theme.surface-2 : transparent;
        border-radius: Theme.radius-control;
        animate background { duration: Theme.normal; }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;

            Avatar {
                size: 28px;
                picture: root.member.avatar;
                fallback: root.member.avatar-fallback;
                initials: root.member.initials;
                presence: root.member.presence;
                speaking: root.member.speaking;
                name: root.member.name;
                y: (parent.height - self.height) / 2;
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    Text {
                        text: root.member.name;
                        // A member's top hoisted role colours their name.
                        color: root.member.role-colour;
                        font-size: 13.3px;
                        font-weight: 560;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.member.badge != "": Rectangle {
                        width: badge.width + 10px;
                        height: 15px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.surface-3;
                        badge := Text {
                            text: root.member.badge;
                            color: Theme.text-muted;
                            font-size: 9.5px;
                            font-weight: 700;
                            letter-spacing: 0.4px;
                        }
                    }
                    if root.member.operator: Icon {
                        data: Icons.shield;
                        size: 12px;
                        colour: Theme.accent;
                        y: (parent.height - self.height) / 2;
                    }
                }

                if root.member.status != "": Text {
                    text: root.member.status;
                    color: Theme.text-faint;
                    font-size: 11.2px;
                    overflow: elide;
                }
            }

            if root.member.deafened: Icon {
                data: Icons.headphones-off;
                size: 14px;
                colour: Theme.danger;
                y: (parent.height - self.height) / 2;
            }
            if root.member.muted && !root.member.deafened: Icon {
                data: Icons.mic-off;
                size: 14px;
                colour: Theme.danger;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.context-menu();
            }
        }
        clicked => { root.activated(); }
    }
}

export component MemberPanel {
    in property <[MemberGroup]> groups;
    in property <int> total;
    callback open-member(string);
    callback member-menu(string);

    width: 236px;

    Rectangle {
        background: Theme.surface-0;

        VerticalLayout {
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Icon {
                        data: Icons.users;
                        size: 16px;
                        colour: Theme.text-faint;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Members";
                        color: Theme.text;
                        font-size: 13.5px;
                        font-weight: 650;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.total;
                        color: Theme.text-faint;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                }
            }
            Divider {}

            Flickable {
                content-height: list.preferred-height;
                list := VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 10px;
                    padding-bottom: 20px;
                    spacing: 1px;

                    for group in root.groups: VerticalLayout {
                        spacing: 1px;
                        Rectangle { height: 14px; }
                        NavLabel {
                            text: group.name;
                            x: 8px;
                        }
                        Rectangle { height: 4px; }
                        for member in group.members: MemberButton {
                            member: member;
                            activated => { root.open-member(member.id); }
                            context-menu => { root.member-menu(member.id); }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        width: 1px;
        background: Theme.border-soft;
    }
}

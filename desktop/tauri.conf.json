{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniChat",
  "version": "0.3.0",
  "identifier": "chat.mini.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "MiniChat desktop client",
    "longDescription": "Voice, video and text chat for a single self-hosted community.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
